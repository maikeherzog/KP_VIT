# ── build the Vite app ──
FROM node:22-alpine AS build
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

# Baked into the bundle at build time: HOST-published URLs the browser uses to
# reach the two backends (the frontend runs in the browser, not in the network).
ARG VITE_API_URL=http://localhost:8000
ARG VITE_LLM_URL=http://localhost:3000
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_LLM_URL=$VITE_LLM_URL
RUN npm run build

# ── serve the static build ──
FROM nginx:alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
